                <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              @each(employee in employees)
                <tr class="hover:bg-pink-50 transition-colors">
                  <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ employee.employeeName }}</td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ employee.annualLeaveBalance }} days</td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ employee.dailyRate.toFixed(2) }}</td>
                  <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ employee.totalLiability.toFixed(2) }}</td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <a href="{{ route('dashboard.liability.employee', [employee.employeeId]) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 text-base font-semibold rounded-xl bg-gradient-to-r from-yellow-400 to-pink-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200">
                      @!svg('ph:eye', { class: 'size-4' })
                      View Details
                    </a>
                  </td>
                </tr>
              @end
            </tbody>
          </table>
