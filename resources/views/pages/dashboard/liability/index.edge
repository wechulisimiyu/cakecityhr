@layout({ title: 'Leave Liability Overview' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-5xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-pink-700 mb-4 flex items-center gap-2">
        @!svg('ph:bank', { class: 'size-7 text-pink-400' })
        Leave Liability Dashboard
      </h1>
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Company Overview</h2>
        <p class="text-xl font-bold text-green-700">Total Liability: KES{{ companyLiability.totalLiability.toFixed(2) }}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        @each(dept in companyLiability.departmentLiabilities)
          <div class="bg-gradient-to-br from-yellow-50 to-white border-l-4 border-yellow-400 rounded-xl p-6 shadow hover:shadow-lg transition-all flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-semibold text-yellow-700 mb-2">{{ dept.departmentName }}</h3>
              <p class="text-base text-gray-700 font-medium">Total: KES{{ dept.total.toFixed(2) }}</p>
            </div>
            <a href="{{ route('dashboard.liability.department', [dept.departmentId]) }}"
               class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-base font-semibold rounded-xl bg-gradient-to-r from-yellow-400 to-pink-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200">
              @!svg('ph:eye', { class: 'size-4' })
              View Details
            </a>
          </div>
        @end
      </div>
    </div>
  </div>
</div>
@end