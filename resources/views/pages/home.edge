@layout({ title: 'Home Page' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-6 px-2 sm:px-4">
  <div class="max-w-5xl mx-auto space-y-8 sm:space-y-10">
    {{-- Hero Section --}}
    <div class="relative bg-white/90 mt-2 sm:mt-4 p-6 sm:p-10 rounded-3xl shadow-2xl flex flex-col items-center overflow-hidden border border-pink-100">
      <div class="absolute -top-10 -right-10 w-32 h-32 sm:w-40 sm:h-40 bg-gradient-to-tr from-pink-200 via-yellow-100 to-transparent rounded-full blur-2xl opacity-60 animate-pulse"></div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-pink-700 mb-3 sm:mb-4 text-center drop-shadow-lg">
        Welcome to Cake City HR Portal
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-gray-700 text-center max-w-2xl mb-4 sm:mb-6">
        Effortlessly manage your leave, track balances, and stay updated with company policies—all in one beautiful dashboard.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full justify-center mt-2">
        @button({
            href: route('leaves.create'),
            type: 'submit',
            variant: 'green',
            class: 'w-full sm:w-auto flex items-center justify-center gap-2 px-5 sm:px-6 py-3 text-base font-semibold transition-all hover:scale-105 transform duration-200 shadow-lg hover:shadow-2xl rounded-xl bg-gradient-to-r from-green-400 to-green-500 text-white'
        })
          @!svg('ph:plus-circle', { class: 'size-6' })
          <span>Apply for Leave</span>
        @end
        @button({
            href: route('leaves.index'),
            type: 'button',
            variant: 'ghost',
            class: 'w-full sm:w-auto flex items-center justify-center gap-2 px-5 sm:px-6 py-3 text-base font-semibold transition-all border-2 border-pink-200 hover:border-pink-400 hover:bg-pink-50 hover:scale-105 transform duration-200 shadow-md hover:shadow-lg rounded-xl text-pink-700'
        })
          @!svg('ph:clock-clockwise', { class: 'size-6' })
          <span>View Applications</span>
        @end
      </div>
    </div>

    {{-- Leave Policies --}}
    <div class="bg-white/90 p-5 sm:p-8 rounded-2xl shadow-xl border border-yellow-100">
      <h2 class="text-xl sm:text-2xl font-bold text-yellow-700 mb-4 sm:mb-6 flex items-center gap-2">
        @!svg('ph:info', { class: 'size-7 text-yellow-500' })
        Our Leave Policies
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
        {{-- Annual Leave --}}
        <div class="bg-gradient-to-br from-yellow-50 to-white border-l-4 border-yellow-400 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-yellow-700 flex items-center gap-2">
            @!svg('ph:sun', { class: 'size-5 text-yellow-400' })
            Annual Leave
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• 21 working days per year</li>
            <li>• Accrual rate: 1.75 days per month</li>
            <li>• Pro-rated for incomplete years</li>
          </ul>
        </div>
        {{-- Sick Leave --}}
        <div class="bg-gradient-to-br from-pink-50 to-white border-l-4 border-pink-400 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-pink-700 flex items-center gap-2">
            @!svg('ph:heartbeat', { class: 'size-5 text-pink-400' })
            Sick Leave
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• 14 calendar days per year</li>
            <li>• First 7 days: Full pay</li>
            <li>• Next 7 days: Half pay</li>
          </ul>
        </div>
        {{-- Maternity Leave --}}
        <div class="bg-gradient-to-br from-pink-100 to-white border-l-4 border-pink-300 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-pink-600 flex items-center gap-2">
            @!svg('ph:baby', { class: 'size-5 text-pink-300' })
            Maternity Leave
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• 90 calendar days</li>
            <li>• Full pay during leave period</li>
          </ul>
        </div>
        {{-- Paternity Leave --}}
        <div class="bg-gradient-to-br from-blue-50 to-white border-l-4 border-blue-300 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-blue-600 flex items-center gap-2">
            @!svg('ph:user', { class: 'size-5 text-blue-300' })
            Paternity Leave
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• 14 calendar days</li>
            <li>• Full pay during leave period</li>
          </ul>
        </div>
        {{-- Other Leaves --}}
        <div class="bg-gradient-to-br from-gray-50 to-white border-l-4 border-gray-300 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-gray-700 flex items-center gap-2">
            @!svg('ph:calendar', { class: 'size-5 text-gray-400' })
            Other Leave Types
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• Public Holiday Compensation: 1 day off</li>
            <li>• Compassionate Leave: Via annual leave</li>
            <li>• Unpaid Leave: Subject to approval</li>
          </ul>
        </div>
        {{-- Quick Info --}}
        <div class="bg-gradient-to-br from-green-50 to-white border-l-4 border-green-300 rounded-xl p-4 sm:p-6 shadow hover:shadow-lg transition-all">
          <h3 class="font-semibold text-base sm:text-lg text-green-700 flex items-center gap-2">
            @!svg('ph:info', { class: 'size-5 text-green-400' })
            Important Information
          </h3>
          <ul class="mt-2 space-y-1 text-gray-600 text-sm sm:text-base">
            <li>• Submit applications at least 2 weeks in advance</li>
            <li>• Medical certificate required for sick leave</li>
            <li>• Leave is subject to approval</li>
          </ul>
        </div>
      </div>
    </div>

    {{-- Contact Information --}}
    <div class="bg-gradient-to-br from-pink-100 to-yellow-50 p-5 sm:p-8 rounded-2xl shadow-xl border border-pink-100 flex flex-col md:flex-row items-center gap-4 sm:gap-6">
      <div class="flex-1">
        <h2 class="text-xl sm:text-2xl font-bold text-pink-700 mb-2 flex items-center gap-2">
          @!svg('ph:lifebuoy', { class: 'size-7 text-pink-400' })
          Need Help?
        </h2>
        <p class="text-gray-700 text-sm sm:text-base">
          Contact our HR Department for any queries or support. We're here to help you!
        </p>
        <p class="text-gray-700 mt-2 sm:mt-3 text-base sm:text-lg font-semibold">
          <span class="inline-flex items-center gap-2">
            @!svg('ph:envelope', { class: 'size-5 text-pink-400' })
            hr@cakecity.co.ke
          </span>
        </p>
      </div>
    </div>
  </div>
</div>
@end
