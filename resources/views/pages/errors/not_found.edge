@layout({ title: '404 Not Found' })
  <div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="max-w-xl w-full bg-white rounded-lg shadow-lg p-8 m-4">
      <div class="text-center">
        <div class="inline-flex rounded-full bg-yellow-100 p-4 mb-4">
          @!svg('ph:warning', { class: 'size-6 text-yellow-600' })
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-4">
          Page Not Found
        </h1>
        <p class="text-gray-600 mb-6">
          Sorry, we couldn't find the page you're looking for.
        </p>
        @button({ href: route('/'), variant: 'ghost' })
          @!svg('ph:arrow-left', { class: 'size-4 mr-2' })
          Return Home
        @end
      </div>
    </div>
  </div>
@end
