@layout({ title: 'Apply Leave' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-2xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-pink-700 mb-2 flex items-center gap-2">
        @!svg('ph:calendar-plus', { class: 'size-7 text-pink-400' })
        Apply for Leave
      </h2>
      <p class="text-gray-600 mb-6">Submit your leave request below.</p>
      @form({ action: route('leaves.store'), class: 'grid gap-y-6' })
        @form.group({ label: 'Leave Type', name: 'type' })
          @!form.select({ 
            options: Object.entries(LeaveType).map(([key, value]) => ({
              label: key.charAt(0) + key.slice(1).toLowerCase(),
              value: value
            })),
            required: true,
            class: 'w-full rounded-lg border-gray-300 focus:ring-pink-400 focus:border-pink-400'
          })
        @end
        @form.group({ label: 'Start Date', name: 'start_date' })
          @!form.input({ type: 'date', required: true, class: 'w-full rounded-lg border-gray-300 focus:ring-pink-400 focus:border-pink-400' })
        @end
        @form.group({ label: 'End Date', name: 'end_date' })
          @!form.input({ type: 'date', required: true, class: 'w-full rounded-lg border-gray-300 focus:ring-pink-400 focus:border-pink-400' })
        @end
        @form.group({ label: 'Reason', name: 'reason' })
          @!form.textarea({ rows: 4, required: true, class: 'w-full rounded-lg border-gray-300 focus:ring-pink-400 focus:border-pink-400' })
        @end
        <div class="mt-3 flex flex-col sm:flex-row justify-end gap-2">
          @button({ 
            type: 'submit', 
            class: 'w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold rounded-xl bg-gradient-to-r from-pink-400 to-yellow-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200',
          })
            @!svg('ph:paper-plane-tilt', { class: 'size-5 mr-2' })
            Submit Leave Request
          @end
        </div>
      @end
    </div>
  </div>
</div>
@end