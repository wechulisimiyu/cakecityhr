@layout({ title: 'My Leave Applications' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-5xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-pink-700 mb-2 flex items-center gap-2">
        @!svg('ph:calendar', { class: 'size-7 text-pink-400' })
        My Leave Balance
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
        {{-- Annual Leave --}}
        <div class="bg-gradient-to-br from-yellow-50 to-white border-l-4 border-yellow-400 rounded-xl p-4 shadow hover:shadow-lg transition-all">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-yellow-700">Annual Leave</p>
              <p class="mt-1 text-2xl font-bold text-gray-900">{{ leaveBalance.annual ?? 21 }}</p>
            </div>
            <div class="bg-yellow-100 p-2 rounded-full">
              @!svg('ph:calendar', { class: 'size-6 text-yellow-500' })
            </div>
          </div>
          <div class="mt-2">
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-yellow-400 h-2 rounded-full" style="width: {{ ((21 - (leaveBalance.annual ?? 21)) / 21) * 100 }}%"></div>
            </div>
            <p class="mt-1 text-xs text-gray-500">{{ 21 - (leaveBalance.annual ?? 21) }} days used</p>
          </div>
        </div>
        {{-- Sick Leave --}}
        <div class="bg-gradient-to-br from-blue-50 to-white border-l-4 border-blue-400 rounded-xl p-4 shadow hover:shadow-lg transition-all">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-blue-700">Sick Leave</p>
              <p class="mt-1 text-2xl font-bold text-gray-900">{{ leaveBalance.sick ?? 14 }}</p>
            </div>
            <div class="bg-blue-100 p-2 rounded-full">
              @!svg('ph:first-aid', { class: 'size-6 text-blue-500' })
            </div>
          </div>
          <div class="mt-2">
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-blue-400 h-2 rounded-full" style="width: {{ ((14 - (leaveBalance.sick ?? 14)) / 14) * 100 }}%"></div>
            </div>
            <p class="mt-1 text-xs text-gray-500">{{ 14 - (leaveBalance.sick ?? 14) }} days used</p>
          </div>
        </div>
        {{-- Paternity Leave --}}
        @if(gender === 1)
        <div class="bg-gradient-to-br from-purple-50 to-white border-l-4 border-purple-400 rounded-xl p-4 shadow hover:shadow-lg transition-all">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-purple-700">Paternity Leave</p>
              <p class="mt-1 text-2xl font-bold text-gray-900">{{ leaveBalance.paternity ?? 14 }}</p>
            </div>
            <div class="bg-purple-100 p-2 rounded-full">
              @!svg('ph:baby', { class: 'size-6 text-purple-500' })
            </div>
          </div>
          <div class="mt-2">
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-purple-400 h-2 rounded-full" style="width: {{ ((14 - (leaveBalance.paternity ?? 14)) / 14) * 100 }}%"></div>
            </div>
            <p class="mt-1 text-xs text-gray-500">{{ 14 - (leaveBalance.paternity ?? 14) }} days used</p>
          </div>
        </div>
        @endif
        {{-- Maternity Leave --}}
        @if(gender === 2)
        <div class="bg-gradient-to-br from-pink-50 to-white border-l-4 border-pink-400 rounded-xl p-4 shadow hover:shadow-lg transition-all">
          <div class="flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-pink-700">Maternity Leave</p>
              <p class="mt-1 text-2xl font-bold text-gray-900">{{ leaveBalance.maternity ?? 90 }}</p>
            </div>
            <div class="bg-pink-100 p-2 rounded-full">
              @!svg('ph:baby', { class: 'size-6 text-pink-500' })
            </div>
          </div>
          <div class="mt-2">
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div class="bg-pink-400 h-2 rounded-full" style="width: {{ ((90 - (leaveBalance.maternity ?? 90)) / 90) * 100 }}%"></div>
            </div>
            <p class="mt-1 text-xs text-gray-500">{{ 90 - (leaveBalance.maternity ?? 90) }} days used</p>
          </div>
        </div>
        @endif
      </div>
    </div>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-4">
      <h2 class="text-xl font-bold text-gray-800">Leave Applications</h2>
      @button({ 
        href: route('leaves.create'), 
        class: 'w-full sm:w-auto flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold rounded-xl bg-gradient-to-r from-pink-400 to-yellow-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200',
      })
        @!svg('ph:plus-circle', { class: 'size-5' })
        Apply for Leave
      @end
    </div>
    <div class="overflow-x-auto rounded-xl shadow border border-gray-200 bg-white/90">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead>
          <tr class="bg-gray-50">
            <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Type</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Start Date</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">End Date</th>
            <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-right font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          @each(leave in leaves)
            <tr class="hover:bg-pink-50 transition-colors">
              <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ leave.type }}</td>
              <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ leave.startDate.toFormat('dd LLL yyyy') }}</td>
              <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ leave.endDate.toFormat('dd LLL yyyy') }}</td>
              <td class="px-4 py-3 whitespace-nowrap text-gray-900">
                @if(leave.status === 'pending')
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
                @elseif(leave.status === 'approved_by_dept_head')
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Approved by Dept Head</span>
                @elseif(leave.status === 'approved_by_hr')
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Approved by HR</span>
                @elseif(leave.status === 'approved_by_ceo')
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Fully Approved</span>
                @else
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Rejected</span>
                @endif
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-right font-medium">
                @button({ 
                  href: route('leaves.show', [leave.id]), 
                  variant: 'ghost', 
                  class: 'inline-flex items-center gap-1 px-4 py-2 rounded-lg bg-gradient-to-r from-yellow-100 to-pink-100 text-pink-700 hover:from-pink-200 hover:to-yellow-200 shadow hover:shadow-lg transition-all',
                })
                  @!svg('ph:eye', { class: 'size-4' })
                  View
                @end
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  </div>
</div>
@end
