@layout({ title: 'Leave Details' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-2xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-pink-700 mb-2 flex items-center gap-2">
        @!svg('ph:clipboard-text', { class: 'size-7 text-pink-400' })
        Leave Application Details
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <div class="bg-gradient-to-br from-yellow-50 to-white border-l-4 border-yellow-400 rounded-xl p-4">
          <h4 class="text-xs font-semibold text-yellow-700 uppercase tracking-wider">Leave Type</h4>
          <p class="mt-2 text-lg font-bold text-gray-900">{{ leave.type }}</p>
        </div>
        <div class="bg-gradient-to-br from-pink-50 to-white border-l-4 border-pink-400 rounded-xl p-4">
          <h4 class="text-xs font-semibold text-pink-700 uppercase tracking-wider">Status</h4>
          <div class="mt-2">
            @if(leave.status === 'pending')
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
            @elseif(leave.status === 'approved_by_dept_head')
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Approved by Dept Head</span>
            @elseif(leave.status === 'approved_by_hr')
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Approved by HR</span>
            @elseif(leave.status === 'approved_by_ceo')
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Fully Approved</span>
            @else
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Rejected</span>
            @endif
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-white border-l-4 border-blue-400 rounded-xl p-4 mt-6">
        <h4 class="text-xs font-semibold text-blue-700 uppercase tracking-wider">Duration</h4>
        <div class="mt-2 space-y-1">
          <p class="text-base text-gray-900">From: <span class="font-medium">{{ leave.startDate.toFormat('dd LLL yyyy') }}</span></p>
          <p class="text-base text-gray-900">To: <span class="font-medium">{{ leave.endDate.toFormat('dd LLL yyyy') }}</span></p>
          <p class="text-sm text-gray-500">Total: {{ leave.days }} days</p>
        </div>
      </div>
      <div class="bg-gradient-to-br from-gray-50 to-white border-l-4 border-gray-400 rounded-xl p-4 mt-6">
        <h4 class="text-xs font-semibold text-gray-700 uppercase tracking-wider">Reason</h4>
        <p class="mt-2 text-base text-gray-900">{{ leave.reason }}</p>
      </div>
      <div class="pt-6 flex flex-col sm:flex-row justify-start gap-3 border-t mt-6">
        @button({ 
          href: route('leaves.index'), 
          variant: 'ghost', 
          class: 'w-full sm:w-auto flex items-center gap-2 px-6 py-3 text-base font-semibold rounded-xl bg-gradient-to-r from-yellow-100 to-pink-100 text-pink-700 hover:from-pink-200 hover:to-yellow-200 shadow hover:shadow-lg transition-all',
        })
          @!svg('ph:arrow-left', { class: 'size-4 mr-2' })
          Back to Leave Applications
        @end
      </div>
    </div>
  </div>
</div>
@end