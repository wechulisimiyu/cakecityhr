@layout({ title: 'Leave Calendar' })
  @card({
    title: 'Leave Calendar',
    description: 'View approved leave schedule'
  })
    <div id="calendar" class="mt-4" style="min-height: 600px"></div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        window.initCalendar({{ JSON.stringify(events) }})
      })
    </script>
  @end
@end