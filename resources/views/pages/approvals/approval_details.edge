@layout({ title: 'Leave Request Details' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-3xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-pink-700 mb-4 flex items-center gap-2">
        @!svg('ph:clipboard-text', { class: 'size-7 text-pink-400' })
        Leave Request Details
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-gradient-to-br from-yellow-50 to-white border-l-4 border-yellow-400 rounded-xl p-6">
          <h4 class="text-sm font-medium text-yellow-700 uppercase tracking-wider mb-4">Employee Details</h4>
          <div class="space-y-3">
            <div>
              <p class="text-sm text-gray-500">Name</p>
              <p class="font-medium">{{ leave.user.fullName }}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Department</p>
              <p class="font-medium">{{ leave.department.name }}</p>
            </div>
          </div>
        </div>
        <div class="bg-gradient-to-br from-pink-50 to-white border-l-4 border-pink-400 rounded-xl p-6">
          <h4 class="text-sm font-medium text-pink-700 uppercase tracking-wider mb-4">Leave Balance</h4>
          <dl class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-sm text-gray-500">Annual Leave</dt>
              <dd class="mt-1 text-2xl font-semibold text-gray-900">{{ leaveBalance.annual }}</dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">Sick Leave</dt>
              <dd class="mt-1 text-2xl font-semibold text-gray-900">{{ leaveBalance.sick }}</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-white border-l-4 border-blue-400 rounded-xl p-6 mt-6">
        <h4 class="text-sm font-medium text-blue-700 uppercase tracking-wider mb-4">Current Request</h4>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">Type</p>
            <p class="font-medium capitalize">{{ leave.type }}</p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Duration</p>
            <p class="font-medium">{{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}</p>
            <p class="text-sm text-gray-500 mt-1">{{ leave.days }} days</p>
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-gray-50 to-white border-l-4 border-gray-400 rounded-xl p-6 mt-6">
        <h4 class="text-sm font-medium text-gray-700 uppercase tracking-wider mb-4">Leave History (This Year)</h4>
        @if(leaveHistory.length)
          <div class="overflow-x-auto rounded-xl shadow border border-gray-200 bg-white/90">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Type</th>
                  <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Period</th>
                  <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                @each(leave in leaveHistory)
                  <tr>
                    <td class="px-4 py-3 whitespace-nowrap">{{ leave.type }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      {{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}
                      <div class="text-xs text-gray-500">{{ leave.days }} days</div>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                        {{ leave.status === 'approved' ? 'bg-green-100 text-green-800' : 
                           leave.status === 'rejected' ? 'bg-red-100 text-red-800' : 
                           'bg-yellow-100 text-yellow-800' }}">
                        {{ leave.status }}
                      </span>
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
        @else
          <p class="text-sm text-gray-500">No previous leave applications this year.</p>
        @end
      </div>
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        @form({ action: route('approvals.accept', [leave.id]), class: 'flex-1' })
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Comments</label>
            <textarea name="comments" rows="3" class="w-full rounded-lg border-gray-300 focus:ring-green-400 focus:border-green-400"></textarea>
          </div>
          @button({ type: 'submit', class: 'w-full flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold rounded-xl bg-gradient-to-r from-green-400 to-green-600 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200' })
            @!svg('ph:check-circle', { class: 'size-5' })
            Approve Leave
          @end
        @end
        @form({ action: route('approvals.reject', [leave.id]), class: 'flex-1' })
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Comments</label>
            <textarea name="comments" rows="3" class="w-full rounded-lg border-gray-300 focus:ring-red-400 focus:border-red-400"></textarea>
          </div>
          @button({ type: 'submit', class: 'w-full flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold rounded-xl bg-gradient-to-r from-red-400 to-pink-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200' })
            @!svg('ph:x-circle', { class: 'size-5' })
            Reject Leave
          @end
        @end
      </div>
    </div>
  </div>
</div>
@end