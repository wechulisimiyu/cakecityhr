@layout({ title: 'Leave Request Details' })
  @card({
    title: 'Leave Request Details',
    description: 'Review and process leave application'
  })
    <div class="space-y-8">
      {{-- Employee Details with Leave Balance --}}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {{-- Employee Info --}}
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Employee Details</h4>
          <div class="space-y-3">
            <div>
              <p class="text-sm text-gray-500">Name</p>
              <p class="font-medium">{{ leave.user.fullName }}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Department</p>
              <p class="font-medium">{{ leave.department.name }}</p>
            </div>
          </div>
        </div>

        {{-- Leave Balance Stats --}}
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
          <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Leave Balance</h4>
          <dl class="grid grid-cols-2 gap-4">
            <div>
              <dt class="text-sm text-gray-500">Annual Leave</dt>
              <dd class="mt-1 text-2xl font-semibold text-gray-900">{{ leaveBalance.annual }}</dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">Sick Leave</dt>
              <dd class="mt-1 text-2xl font-semibold text-gray-900">{{ leaveBalance.sick }}</dd>
            </div>
          </dl>
        </div>
      </div>

      {{-- Current Leave Request --}}
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Current Request</h4>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">Type</p>
            <p class="font-medium capitalize">{{ leave.type }}</p>
          </div>
          <div>
            <p class="text-sm text-gray-500">Duration</p>
            <p class="font-medium">{{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}</p>
            <p class="text-sm text-gray-500 mt-1">{{ leave.days }} days</p>
          </div>
        </div>
      </div>

      {{-- Leave History --}}
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <h4 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Leave History (This Year)</h4>
        @if(leaveHistory.length)
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Period</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                @each(leave in leaveHistory)
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">{{ leave.type }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                      {{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}
                      <div class="text-xs text-gray-500">{{ leave.days }} days</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                        {{ leave.status === 'approved' ? 'bg-green-100 text-green-800' : 
                           leave.status === 'rejected' ? 'bg-red-100 text-red-800' : 
                           'bg-yellow-100 text-yellow-800' }}">
                        {{ leave.status }}
                      </span>
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
        @else
          <p class="text-sm text-gray-500">No previous leave applications this year.</p>
        @end
      </div>

      {{-- Existing Approval Actions --}}
      <div class="flex gap-4">
        @form({ action: route('approvals.accept', [leave.id]) })
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Comments</label>
            <textarea name="comments" rows="3" class="w-96 rounded-md border-gray-300"></textarea>
          </div>
          @button({ type: 'submit', class: 'bg-green-600 hover:bg-green-700' })
            Approve Leave
          @end
        @end

        @form({ action: route('approvals.reject', [leave.id]) })
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Comments</label>
            <textarea name="comments" rows="3" class="w-96 rounded-md border-gray-300"></textarea>
          </div>
          @button({ type: 'submit', class: 'bg-red-600 hover:bg-red-700' })
            Reject Leave
          @end
        @end
      </div>
    </div>
  @end
@end