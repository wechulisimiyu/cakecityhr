@layout({ title: 'Leave Approvals' })
  @card({
  title: userRole === Role.DEPARTMENT_HEAD
    ? `${department?.name || 'Unknown'} Department - Pending Approvals`
    : userRole === Role.HR
      ? 'HR Review - Department Approved Leaves'
      : 'CEO Final Approval - HR Reviewed Leaves',
  description: userRole === Role.DEPARTMENT_HEAD
    ? `Review leave requests from ${department?.name || 'your'} department members`
    : userRole === Role.HR
      ? 'Review leave requests forwarded by department heads'
      : 'Review leave requests approved by HR'
  })
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead>
          <tr class="bg-gray-50">
            <th
              scope="col"
              class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
            >
              Employee
            </th>
            <th
              scope="col"
              class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
            >
              Type
            </th>
            <th
              scope="col"
              class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
            >
              Duration
            </th>
            {{-- <th
              scope="col"
              class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
            >
              Reason
            </th> --}}
            <th
              scope="col"
              class="px-6 py-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
            >
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          @each(leave in leaves)
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {{ leave.user.fullName }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span
                  class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {{ leave.type === 'annual' ? 'bg-green-100 text-green-800' :
                  leave.type === 'sick' ? 'bg-blue-100 text-blue-800' :
                  leave.type === 'maternity' ? 'bg-pink-100 text-pink-800' :
                  leave.type === 'paternity' ? 'bg-purple-100 text-purple-800' :
                  leave.type === 'compassionate' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-gray-100 text-gray-800' }}"
                >
                  {{ leave.type }}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900">
                  {{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}
                </div>
                <div class="text-xs text-gray-500 mt-1">
                  {{ leave.days }} days
                </div>
              </td>
              {{-- <td class="px-6 py-4">
                <div class="text-sm text-gray-900 max-w-md">
                  {{ leave.reason }}
                </div>
              </td> --}}
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                @button({ href: route('approvals.show', [leave.id]), variant: 'ghost' })
                  View
                @end
              </td>
              {{-- <td class="px-6 py-4 whitespace-nowrap">
                @form({ action: route('leaves.approve', [leave.id]) })
                  <div class="space-y-3">
                    @form.group({ label: 'Comments', name: 'comments' })
                      @!form.textarea({
                        rows: 2,
                        placeholder: 'Optional: Add comments about this approval',
                        class: 'w-full text-sm'
                      })
                    @end
                    
                    @button({
                      type: 'submit',
                      variant: userRole === Role.DEPARTMENT_HEAD ? 'brown' :
                              userRole === Role.HR ? 'purple' :
                              'magenta',
                      class: 'w-full inline-flex items-center justify-center gap-x-2 py-2.5 px-4 text-sm font-semibold rounded-lg border border-transparent transition-colors'
                    })
                      @!svg('ph:check-circle', { class: 'size-4 mr-2' })
                      {{ userRole === Role.DEPARTMENT_HEAD ? 'Forward to HR' :                          userRole === Role.HR ? 'Forward to CEO' :                          'Approve Leave' }}
                    @end
                  </div>
                @end
              </td> --}}
            </tr>
          @else
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500 bg-gray-50">
                No pending leave requests to approve
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  @end
@end
