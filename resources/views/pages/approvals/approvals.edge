@layout({ title: 'Leave Approvals' })
<div class="min-h-screen bg-gradient-to-br from-pink-50 via-yellow-50 to-white py-8">
  <div class="max-w-6xl mx-auto space-y-8 px-2 sm:px-4">
    <div class="bg-white/90 rounded-2xl shadow-xl border border-yellow-100 p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-pink-700 mb-4 flex items-center gap-2">
        @!svg('ph:clipboard-text', { class: 'size-7 text-pink-400' })
        @if(userRole === Role.DEPARTMENT_HEAD)
          {{ department?.name || 'Unknown' }} Department - Pending Approvals
        @elseif(userRole === Role.HR)
          HR Review - Department Approved Leaves
        @else
          CEO Final Approval - HR Reviewed Leaves
        @endif
      </h2>
      <p class="text-gray-600 mb-6">
        @if(userRole === Role.DEPARTMENT_HEAD)
          Review leave requests from {{ department?.name || 'your' }} department members
        @elseif(userRole === Role.HR)
          Review leave requests forwarded by department heads
        @else
          Review leave requests approved by HR
        @endif
      </p>
      <div class="overflow-x-auto rounded-xl shadow border border-gray-200 bg-white/90">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead>
            <tr class="bg-gray-50">
              <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Employee</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Type</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Duration</th>
              <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            @each(leave in leaves)
              <tr class="hover:bg-pink-50 transition-colors">
                <td class="px-4 py-3 whitespace-nowrap text-gray-900">{{ leave.user.fullName }}</td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold
                    {{ leave.type === 'annual' ? 'bg-green-100 text-green-800' :
                    leave.type === 'sick' ? 'bg-blue-100 text-blue-800' :
                    leave.type === 'maternity' ? 'bg-pink-100 text-pink-800' :
                    leave.type === 'paternity' ? 'bg-purple-100 text-purple-800' :
                    leave.type === 'compassionate' ? 'bg-yellow-100 text-yellow-800' :
                    'bg-gray-100 text-gray-800' }}">
                    {{ leave.type }}
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <div class="text-sm text-gray-900">{{ leave.startDate.toFormat('dd LLL yyyy') }} - {{ leave.endDate.toFormat('dd LLL yyyy') }}</div>
                  <div class="text-xs text-gray-500 mt-1">{{ leave.days }} days</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-right font-medium">
                  @button({ href: route('approvals.show', [leave.id]), class: 'inline-flex items-center gap-2 px-4 py-2 text-base font-semibold rounded-xl bg-gradient-to-r from-yellow-400 to-pink-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200' })
                    @!svg('ph:eye', { class: 'size-4' })
                    View
                  @end
                </td>
              </tr>
            @else
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500 bg-gray-50">No pending leave requests to approve</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
@end
