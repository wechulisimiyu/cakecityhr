<aside 
  id="app-sidebar"
  class="fixed top-[6.5rem] left-0 z-20 transition-all duration-300 bg-white border-r border-gray-200
         h-[calc(100vh-6.5rem)]"
  :class="isSidebarOpen ? 'w-64' : 'w-16'"
  aria-label="Sidebar"
>
  {{-- Toggle Button - Mobile Only --}}
  <button
    @click="toggleSidebar()"
    type="button"
    class="absolute -right-10 top-3 inline-flex items-center p-2 text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 md:hidden"
  >
    <span class="sr-only">Toggle sidebar</span>
    @!svg('ph:list', { class: 'size-6' })
  </button>

  <div class="h-full px-3 py-4 overflow-y-auto">
    <ul class="space-y-2 font-medium">
      {{-- Dashboard --}}
      <li>
        <a href="{{ route('/') }}" class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          @!svg('ph:squares-four', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
          <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Dashboard</span>
        </a>
      </li>

      {{-- Leave Applications --}}
      <li>
        <a href="{{ route('/leave') }}" class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          @!svg('ph:calendar', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
          <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Apply Leave </span>
        </a>
      </li>

      @if(await auth.check() && auth.user.roleId !== Role.EMPLOYEE)
        {{-- Approvals --}}
        <li>
          <a href="{{ route('/approvals') }}" class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
            @!svg('ph:check-circle', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
            <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Leave Approvals</span>
          </a>
        </li>

        {{-- Liability --}}
        <li>
          <a href="{{ route('/dashboard/liability') }}" class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
            @!svg('ph:chart-line', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
            <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Leave Liability</span>
          </a>
        </li>
      @endif

      {{-- Settings --}}
      <li>
        <a href="{{ route('settings.profile') }}" class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          @!svg('ph:gear', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
          <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Settings</span>
        </a>
      </li>

      {{-- Logout --}}
      <li>
        @form({ action: route('auth.logout') })
          <button type="submit" class="w-full flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
            @!svg('ph:sign-out', { class: 'size-5 text-gray-500 transition duration-75 group-hover:text-gray-900' })
            <span class="ms-3 transition-opacity duration-300" :class="isSidebarOpen ? 'opacity-100' : 'opacity-0'">Logout</span>
          </button>
        @end
      </li>
    </ul>
  </div>
</aside>