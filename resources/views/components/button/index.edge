@let(tag = $props.href ? 'a' : 'button')
@let(variant = $props.variant ?? 'primary')
@let(variants = new Map([
  ['primary', 'bg-primary text-white hover:bg-primary/90 focus:bg-primary/90'],
  ['ghost', 'bg-white text-gray-700 hover:bg-gray-50 focus:bg-gray-50 border border-gray-300'],
  ['blue', 'bg-blue-600 text-white hover:bg-blue-700 focus:bg-blue-700 border border-blue-200'],
  ['red', 'bg-red-600 text-white hover:bg-red-700 focus:bg-red-700 border border-red-200'],
  ['green', 'bg-green-600 text-white hover:bg-green-700 focus:bg-green-700 border border-green-200'],
  ['yellow', 'bg-yellow-500 text-white hover:bg-yellow-600 focus:bg-yellow-600 border border-yellow-200'],
  ['purple', 'bg-purple-600 text-white hover:bg-purple-700 focus:bg-purple-700 border border-purple-200']
]))

@let(baseClasses = `inline-flex items-center justify-center gap-x-2 py-2.5 px-4 text-sm font-semibold rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none ${variants.get(variant)}`)

<{{ tag }} {{ $props.except(['variant']).merge({ class: baseClasses }).toAttrs() }}>
  @if (type === 'submit')
    <span x-cloak x-show="isWorking" class="flex items-center gap-1.5">
      @svg('svg-spinners:blocks-shuffle-3')
    </span>
  @endif
  
  {{{ await $slots.main() }}}
</{{ tag }}>