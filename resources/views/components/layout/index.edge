<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if ($slots.head)
      {{{ await $slots.head() }}}
    @endif
    <title>
      {{ title || app.appName }} - Leave Management
    </title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    <script src="https://cdn.jsdelivr.net/npm/chart.js">
      
    </script>
  </head>
  <body class="bg-gray-100">
    <!-- Navigation -->

    <section class="w-full px-0 sm:px-0 antialiased bg-gradient-to-r from-pink-100 via-yellow-50 to-white shadow-md border-b border-pink-200">
      <div class="mx-auto max-w-7xl">
        <nav class="relative z-50 h-20 select-none" x-data="{ showMenu: false, dropdownOpen: false }">
          <div class="container relative flex flex-wrap items-center justify-between h-20 mx-auto font-medium md:overflow-visible lg:justify-center sm:px-4 md:px-2 lg:px-0">
            <!-- Logo -->
            <div class="flex items-center justify-start h-full pr-2 sm:pr-4 w-1/2 sm:w-1/4">
              <a href="{{ route('/') }}" class="flex items-center py-2 md:py-0 gap-2">
                <img src="/images/logo.webp" alt="{{ app.appName }}" class="h-14 w-auto sm:h-20 drop-shadow-lg rounded-full border-2 border-pink-200 bg-white" />
                <span class="hidden sm:inline text-2xl font-extrabold text-pink-700 tracking-tight drop-shadow">CakeCity HR</span>
              </a>
            </div>
            <!-- Mobile menu button -->
            <div
              @click="showMenu = !showMenu"
              class="absolute right-2 sm:right-0 flex flex-col items-center justify-center w-10 h-10 bg-gradient-to-br from-pink-200 to-yellow-100 rounded-full cursor-pointer md:hidden border-2 border-pink-200 shadow hover:scale-105 transition-all"
              aria-label="Toggle navigation"
              :aria-expanded="showMenu.toString()"
            >
              <svg class="w-7 h-7 text-pink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
              </svg>
            </div>
            <!-- Navigation Menu -->
            <div
              class="top-0 left-0 items-start hidden w-full h-full p-4 text-sm bg-white/95 md:items-center md:w-3/4 md:relative lg:text-base md:bg-transparent md:p-0 md:flex"
              :class="{'flex fixed inset-0 z-40': showMenu, 'hidden': !showMenu }"
            >
              <div
                class="flex-col w-full h-auto overflow-y-auto bg-white rounded-2xl md:bg-transparent md:overflow-visible md:rounded-none md:relative md:flex md:flex-row shadow md:shadow-none border md:border-0 border-pink-100"
              >
                <!-- Main Navigation Links -->
                <div
                  class="flex flex-col items-start justify-center w-full space-y-2 md:space-y-0 md:space-x-6 text-center lg:space-x-8 md:w-2/3 md:mt-0 md:flex-row md:items-center"
                >
                  <a
                    href="{{ route('/') }}"
                    class="inline-flex items-center gap-2 w-full py-2 mx-0 font-semibold text-pink-700 md:w-auto md:px-0 md:mx-2 hover:text-pink-900 hover:bg-pink-50 rounded-lg transition-all lg:mx-3 md:text-center"
                  >Home</a>
                  <a
                    href="{{ route('/leave') }}"
                    class="inline-flex items-center gap-2 w-full py-2 mx-0 font-semibold text-yellow-700 md:w-auto md:px-0 md:mx-2 hover:text-yellow-900 hover:bg-yellow-50 rounded-lg transition-all lg:mx-3 md:text-center"
                  >Apply for Leave</a>
                  @if (await auth.check() && auth.user.roleId !== Role.EMPLOYEE)
                    <a
                      href="{{ route('/dashboard') }}"
                      class="inline-flex items-center gap-2 w-full py-2 mx-0 font-semibold text-blue-700 md:w-auto md:px-0 md:mx-2 hover:text-blue-900 hover:bg-blue-50 rounded-lg transition-all lg:mx-3 md:text-center"
                    >Dashboard</a>
                  @endif
                </div>
                <!-- Auth Section -->
                <div
                  class="flex flex-col items-start justify-end w-full md:items-center md:w-1/3 md:flex-row md:py-0 space-y-2 md:space-y-0"
                >
                  @if (await auth.check())
                    <div x-data="{ dropdownOpen: false }" class="relative">
                      <button
                        @click="dropdownOpen = !dropdownOpen"
                        class="inline-flex items-center justify-center w-12 h-12 text-lg font-bold transition-colors bg-gradient-to-br from-pink-200 to-yellow-100 border-2 border-pink-200 rounded-full hover:bg-pink-100 active:bg-white focus:bg-white focus:outline-none focus:ring-2 focus:ring-pink-200/60 focus:ring-offset-2 shadow"
                        aria-label="User menu"
                        :aria-expanded="dropdownOpen.toString()"
                      >
                        @if(auth.user.fullName)
                          <span class="text-lg font-bold text-pink-700">
                            {{ auth.user.fullName.charAt(0).toUpperCase() }}
                          </span>
                        @endif
                      </button>
                      <div
                        x-show="dropdownOpen"
                        @click.away="dropdownOpen = false"
                        x-transition:enter="ease-out duration-200"
                        x-transition:enter-start="-translate-y-2"
                        x-transition:enter-end="translate-y-0"
                        class="absolute right-0 z-50 w-56 mt-2 origin-top-right bg-white border border-pink-100 rounded-xl shadow-lg"
                        x-cloak
                      >
                        <div class="p-1 text-sm text-gray-700">
                          <a
                            href="{{ route('settings.profile') }}"
                            class="relative flex w-full px-2 py-1.5 rounded-lg hover:bg-pink-50 hover:text-pink-900"
                          >
                            Profile Settings
                          </a>
                          <a
                            href="{{ route('settings.account') }}"
                            class="relative flex w-full px-2 py-1.5 rounded-lg hover:bg-yellow-50 hover:text-yellow-900"
                          >
                            Account Settings
                          </a>
                          <div class="h-px my-1 -mx-1 bg-pink-100"></div>
                          @form({ action: route('auth.logout') })
                            <button
                              type="submit"
                              class="relative flex w-full px-2 py-1.5 text-left rounded-lg hover:bg-red-50 hover:text-red-700"
                            >
                              Logout
                            </button>
                          @end
                        </div>
                      </div>
                    </div>
                  @else
                    <div class="flex flex-row gap-2 w-full md:w-auto">
                      @button({ href: route('auth.login.show'), class: 'w-full md:w-auto flex items-center gap-2 px-4 py-2 text-base font-semibold rounded-xl bg-gradient-to-r from-pink-400 to-yellow-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200' })
                        <span>Login</span>
                      @end
                      @button({ href: route('auth.register.show'), class: 'w-full md:w-auto flex items-center gap-2 px-4 py-2 text-base font-semibold rounded-xl bg-gradient-to-r from-yellow-400 to-pink-400 text-white shadow-lg hover:scale-105 hover:shadow-2xl transition-all duration-200' })
                        <span>Register</span>
                      @end
                    </div>
                  @endif
                </div>
              </div>
            </div>
          </div>
        </nav>
      </div>
    </section>
    <!-- End Navigation -->

    {{-- Main Content with Sidebar --}}
    <div class="relative md:flex">
      @!component('components/sidebar/index')

      <main class="w-full min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          {{{ await $slots.main() }}}
        </div>
      </main>
    </div>

    {{-- Footer --}}
    <footer class="w-full bg-gradient-to-r from-pink-50 via-yellow-50 to-white border-t border-pink-200 mt-12">
      <div class="max-w-7xl mx-auto px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <img src="/images/logo.webp" alt="{{ app.appName }}" class="h-14 w-14 sm:h-20 sm:w-20 drop-shadow-lg rounded-full border-2 border-pink-200 bg-white object-contain" />
          <span class="text-xl font-extrabold text-pink-700 tracking-tight drop-shadow">CakeCity HR</span>
        </div>
        <div class="text-sm text-gray-500 text-center md:text-right">
          &copy; {{ new Date().getFullYear() }} Cake City HR. All rights reserved.
        </div>
      </div>
    </footer>
    {{-- End Footer --}}

    @!toast.flash()
  </body>
</html>
