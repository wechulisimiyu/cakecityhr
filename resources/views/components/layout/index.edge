<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if ($slots.head)
      {{{ await $slots.head() }}}
    @endif
    <title>
      {{ title || app.appName }} - Leave Management
    </title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
  </head>
  <body class="bg-gray-100">
    <!-- Navigation -->

    <section class="w-full px-6 antialiased bg-white">
      <div class="mx-auto max-w-7xl">
        <nav class="relative z-50 h-24 select-none" x-data="{ showMenu: false, dropdownOpen: false }">
          <div
            class="container relative flex flex-wrap items-center justify-between h-24 mx-auto overflow-hidden font-medium border-b border-gray-200 md:overflow-visible lg:justify-center sm:px-4 md:px-2 lg:px-0"
          >

            <!-- Logo -->
            <div class="flex items-center justify-start w-1/4 h-full pr-4">
              <a href="{{ route('/') }}" class="flex items-center py-4 md:py-0">
                <img src="/images/logo.webp" alt="{{ app.appName }}" class="h-24 w-auto" />
              </a>
            </div>

            <!-- Mobile menu button -->
            <div
              @click="showMenu = !showMenu"
              class="absolute right-0 flex flex-col items-center justify-center w-10 h-10 bg-white rounded-full cursor-pointer md:hidden hover:bg-gray-100"
            >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
            </svg>
            </div>

            <!-- Navigation Menu -->
            <div
              class="top-0 left-0 items-start hidden w-full h-full p-4 text-sm bg-gray-900 bg-opacity-50 md:items-center md:w-3/4 md:absolute lg:text-base md:bg-transparent md:p-0 md:relative md:flex"
              :class="{'flex fixed': showMenu, 'hidden': !showMenu }"
            >
              <div
                class="flex-col w-full h-auto overflow-hidden bg-white rounded-lg md:bg-transparent md:overflow-visible md:rounded-none md:relative md:flex md:flex-row"
              >
                <!-- Main Navigation Links -->
                <div
                  class="flex flex-col items-start justify-center w-full space-x-6 text-center lg:space-x-8 md:w-2/3 md:mt-0 md:flex-row md:items-center"
                >
                  <a
                    href="{{ route('/') }}"
                    class="inline-block w-full py-2 mx-0 font-medium text-left text-gray-700 md:w-auto md:px-0 md:mx-2 hover:text-black lg:mx-3 md:text-center"
                  >Home</a>

                  <a
                    href="{{ route('/leave') }}"
                    class="inline-block w-full py-2 mx-0 font-medium text-left text-gray-700 md:w-auto md:px-0 md:mx-2 hover:text-black lg:mx-3 md:text-center"
                  >Apply for Leave</a>

                  @if (await auth.check() && auth.user.roleId !== Role.EMPLOYEE)
                    <a
                      href="{{ route('/approvals') }}"
                      class="inline-block w-full py-2 mx-0 font-medium text-left text-gray-700 md:w-auto md:px-0 md:mx-2 hover:text-black lg:mx-3 md:text-center"
                    >Leave Approvals</a>
                  @endif
                    
                  @if (await auth.check() && (auth.user.roleId === Role.HR || auth.user.roleId === Role.CEO))
                    <a
                      href="{{ route('/dashboard/liability') }}"
                      class="inline-block w-full py-2 mx-0 font-medium text-left text-gray-700 md:w-auto md:px-0 md:mx-2 hover:text-black lg:mx-3 md:text-center"
                    >Liability</a>
                  @endif

                  @if (await auth.check() && (auth.user.roleId === Role.HR || auth.user.roleId === Role.CEO))
                    <a
                      href="{{ route('/dashboard/people') }}"
                      class="inline-block w-full py-2 mx-0 font-medium text-left text-gray-700 md:w-auto md:px-0 md:mx-2 hover:text-black lg:mx-3 md:text-center"
                    >People</a>
                  @endif
                </div>

                <!-- Auth Section -->
                <div
                  class="flex flex-col items-start justify-end w-full md:items-center md:w-1/3 md:flex-row md:py-0"
                >
                  @if (await auth.check())
                    <div x-data="{ dropdownOpen: false }" class="relative">
                      <button
                        @click="dropdownOpen = !dropdownOpen"
                        class="inline-flex items-center justify-center w-10 h-10 text-sm font-medium transition-colors bg-white border rounded-full hover:bg-gray-100 active:bg-white focus:bg-white focus:outline-none focus:ring-2 focus:ring-gray-200/60 focus:ring-offset-2"
                      >
                        @if(auth.user.fullName)
                          <span class="text-sm font-medium text-gray-700">
                            {{ auth.user.fullName.charAt(0).toUpperCase() }}
                          </span>
                        @else
                          @!svg('ph:user', { class: 'w-5 h-5' })
                        @endif
                      </button>

                      <div
                        x-show="dropdownOpen"
                        @click.away="dropdownOpen = false"
                        x-transition:enter="ease-out duration-200"
                        x-transition:enter-start="-translate-y-2"
                        x-transition:enter-end="translate-y-0"
                        class="absolute right-0 z-50 w-56 mt-2 origin-top-right bg-white border rounded-md shadow-lg"
                        x-cloak
                      >
                        <div class="p-1 text-sm text-gray-700">
                          {{-- <span class="font-medium">{{ auth.user.fullName }}</span> --}}
                          <a
                            href="{{ route('settings.profile') }}"
                            class="relative flex w-full px-2 py-1.5 hover:bg-gray-100 hover:text-gray-900"
                          >
                            <span>Profile Settings</span>
                          </a>
                          <a
                            href="{{ route('settings.account') }}"
                            class="relative flex w-full px-2 py-1.5 hover:bg-gray-100 hover:text-gray-900"
                          >
                            <span>Account Settings</span>
                          </a>
                          <div class="h-px my-1 -mx-1 bg-gray-200">
                          </div>
                          @form({ action: route('auth.logout') })
                            <button
                              type="submit"
                              class="relative flex w-full px-2 py-1.5 text-left hover:bg-gray-100 hover:text-gray-900"
                            >
                              <span>Logout</span>
                            </button>
                          @end
                        </div>
                      </div>
                    </div>
                  @else
                    @button({ href: route('auth.login.show'), variant: 'ghost' })
                      Login
                    @end
                    @button({ href: route('auth.register.show') })
                      Register
                    @end
                  @endif
                </div>
              </div>
            </div>
          </div>
        </nav>
      </div>
    </section>
    <!-- End Navigation -->

    {{-- Main Content with Sidebar --}}
    <div class="relative md:flex">
      @!component('components/sidebar/index')

            <main class="w-full min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          {{{ await $slots.main() }}}
        </div>
      </main>
    </div>

    @!toast.flash()
  </body>
</html>
